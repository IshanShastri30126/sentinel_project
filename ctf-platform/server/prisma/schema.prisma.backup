// Created: 2026-08-02 | Modified: Initial creation — Prisma schema with shared User model + 6 CTF models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SHARED MODELS (Exist in Sentinel's database — DO NOT MODIFY)
// We define them here so Prisma understands the relationships.
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  FACULTY
  STUDENT
  MEMBER
  EVALUATOR
  GUEST
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  password       String?
  role           Role     @default(MEMBER)
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // CTF Wars relationships
  ctfParticipations CtfParticipant[]

  @@map("users")
}

// ============================================================
// CTF WARS MODELS (New — created by this project)
// ============================================================

// --- ENUMS ---

enum CtfCompetitionState {
  DRAFT
  OPEN
  ACTIVE
  PAUSED
  ENDED
}

enum CtfChallengeCategory {
  WEB
  CRYPTO
  REVERSING
  FORENSICS
  OSINT
  STEGO
  MISC
}

enum CtfDifficulty {
  EASY
  MEDIUM
  HARD
  INSANE
}

enum CtfFlagType {
  EXACT
  REGEX
  MANUAL_REVIEW
}

enum CtfSubmissionResult {
  CORRECT
  INCORRECT
  PENDING_REVIEW
}

enum CtfActivityStatus {
  OPENED
  ATTEMPTED
  SOLVED
}

enum CtfTier {
  APPRENTICE
  JOURNEYMAN
  MASTER
  GRANDMASTER
}

// --- TABLE A: Competitions ---

model CtfCompetition {
  id          String               @id @default(uuid())
  title       String
  description String?
  rules       String?
  state       CtfCompetitionState  @default(DRAFT)
  startTime   DateTime?
  endTime     DateTime?
  inviteCode  String?              @unique
  version     Int                  @default(1)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relations
  challenges   CtfChallenge[]
  participants CtfParticipant[]

  @@map("ctf_competitions")
}

// --- TABLE B: Challenges ---

model CtfChallenge {
  id            String               @id @default(uuid())
  title         String
  description   String?
  category      CtfChallengeCategory
  difficulty    CtfDifficulty        @default(EASY)
  flagHash      String               // bcrypt-hashed flag value
  flagType      CtfFlagType          @default(EXACT)

  // Parabolic Decay Scoring
  initialPoints Int                  @default(500)
  decayCount    Int                  @default(20)
  minimumPoints Int                  @default(50)
  currentPoints Int                  @default(500)

  solveCount    Int                  @default(0)
  version       Int                  @default(1)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relations
  competitionId String
  competition   CtfCompetition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  hints         CtfHint[]
  submissions   CtfSubmission[]
  activities    CtfChallengeActivity[]

  @@map("ctf_challenges")
}

// --- TABLE C: Hints ---

model CtfHint {
  id         String   @id @default(uuid())
  content    String
  pointCost  Int      @default(0)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  // Relations
  challengeId String
  challenge   CtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("ctf_hints")
}

// --- TABLE D: Participants ---

model CtfParticipant {
  id          String   @id @default(uuid())
  totalScore  Int      @default(0)
  tier        CtfTier  @default(APPRENTICE)
  lastSolveAt DateTime?
  version     Int      @default(1)
  joinedAt    DateTime @default(now())

  // Relations
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId String
  competition   CtfCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  submissions   CtfSubmission[]
  activities    CtfChallengeActivity[]

  // A user can only register once per competition
  @@unique([userId, competitionId])
  @@map("ctf_participants")
}

// --- TABLE E: Challenge Activity (Powers the Admin Progression Matrix) ---

model CtfChallengeActivity {
  id        String            @id @default(uuid())
  status    CtfActivityStatus @default(OPENED)
  updatedAt DateTime          @updatedAt

  // Relations
  participantId String
  participant   CtfParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  challengeId   String
  challenge     CtfChallenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  // One activity record per participant per challenge
  @@unique([participantId, challengeId])
  @@map("ctf_challenge_activity")
}

// --- TABLE F: Submissions (Raw log of every flag guess) ---

model CtfSubmission {
  id            String              @id @default(uuid())
  submittedHash String              // What the user guessed (hashed)
  result        CtfSubmissionResult @default(INCORRECT)
  pointsAwarded Int                 @default(0)
  submittedAt   DateTime            @default(now())

  // Relations
  participantId String
  participant   CtfParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  challengeId   String
  challenge     CtfChallenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("ctf_submissions")
}
