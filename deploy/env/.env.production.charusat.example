# ==============================================================================
# SENTINAL & CTF WARS — CHARUSAT PRODUCTION ENVIRONMENT CONFIGURATION
# FILE: /opt/sentinel/.env.production
# NOTE: All secret keys, database passwords, and tokens must be securely provisioned.
# ==============================================================================

# 1. Core Server Environment
NODE_ENV=production
PORT=4000
CLIENT_URL=https://sentinel.charusat.ac.in
CTF_URL=https://ctf.charusat.ac.in

# 2. Database Connection (PostgreSQL 16 On-Premises Campus Host)
# Calibrated connection limit must be derived in Phase 33
DATABASE_URL=postgresql://sentinel_prod_user:[REDACTED_CAMPUS_DB_PASS]@10.10.20.15:5432/sentinel_prod?sslmode=prefer&connection_limit=20

# 3. Redis Architecture (Local Subnet Native TCP)
# Direct TCP socket eliminates REST overhead (~0.5ms RTT)
REDIS_URL=redis://:REDACTED_REDIS_PASS@10.10.20.16:6379/0

# 4. Authentication & Security
# Cryptographically random 64-byte secret key (CSPRNG generated)
JWT_SECRET=[REDACTED_64_BYTE_BASE64_SECRET]
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 5. Reverse Proxy & Network Protection
TRUST_PROXY=1
ENABLE_WAF=true
STRICT_CORS=true

# 6. University Email Gateway (Charusat Internal SMTP Relay)
SMTP_HOST=mail.charusat.ac.in
SMTP_PORT=587
SMTP_USER=sentinel-notifications@charusat.ac.in
SMTP_PASS=[REDACTED_SMTP_PASS]
EMAIL_FROM="Sentinel System <sentinel-notifications@charusat.ac.in>"

# 7. File Storage Directory
UPLOAD_DIR=/var/data/sentinel/uploads

# 8. Rate Limiting & Telemetry
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
ENABLE_PERF_METRICS=true
